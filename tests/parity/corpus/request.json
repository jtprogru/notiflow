  {
    "id": "request-edit-drops-notification-and-thread",
    "kind": "request",
    "why": "Telegram rejects disable_notification and message_thread_id on editMessageText, so both are dropped.",
    "divergence": "fix: disable_web_page_preview replaced by link_preview_options (plan 2.2.7)",
    "env": {
      "NF_EDIT_MESSAGE_ID": "42",
      "NF_MESSAGE_THREAD_ID": "7",
      "NF_DISABLE_NOTIFICATION": "true",
      "NF_MESSAGE": "edited"
    },
    "expected_v1": {
      "exit": 0,
      "value": "{\"chat_id\": -1001234567890, \"disable_web_page_preview\": true, \"message_id\": 42, \"parse_mode\": \"MarkdownV2\", \"text\": \"edited\"}"
    },
    "expected_v2": {
      "exit": 0,
      "value": "{\"chat_id\": -1001234567890, \"link_preview_options\": {\"is_disabled\": true}, \"message_id\": 42, \"parse_mode\": \"MarkdownV2\", \"text\": \"edited\"}"
    }
  },
  {
    "id": "request-escapes-json-correctly",
    "kind": "request",
    "why": "Quotes, backslashes and newlines in the body must survive JSON encoding.",
    "divergence": "fix: disable_web_page_preview replaced by link_preview_options (plan 2.2.7)",
    "env": {
      "NF_MESSAGE": "quote\" backslash\\ newline\ntab\tend"
    },
    "expected_v1": {
      "exit": 0,
      "value": "{\"chat_id\": -1001234567890, \"disable_notification\": false, \"disable_web_page_preview\": true, \"parse_mode\": \"MarkdownV2\", \"text\": \"quote\\\" backslash\\\\ newline\\ntab\\tend\"}"
    },
    "expected_v2": {
      "exit": 0,
      "value": "{\"chat_id\": -1001234567890, \"disable_notification\": false, \"link_preview_options\": {\"is_disabled\": true}, \"parse_mode\": \"MarkdownV2\", \"text\": \"quote\\\" backslash\\\\ newline\\ntab\\tend\"}"
    }
  }
]
