[
  {
    "id": "request-basic",
    "kind": "request",
    "why": "The default send body.",
    "divergence": "fix: disable_web_page_preview replaced by link_preview_options (plan 2.2.7)",
    "env": {
      "NF_MESSAGE": "hello"
    },
    "expected_v1": {
      "exit": 0,
      "value": "{\"chat_id\": -1001234567890, \"disable_notification\": false, \"disable_web_page_preview\": true, \"parse_mode\": \"MarkdownV2\", \"text\": \"hello\"}"
    },
    "expected_v2": {
      "exit": 0,
      "value": "{\"chat_id\": -1001234567890, \"disable_notification\": false, \"link_preview_options\": {\"is_disabled\": true}, \"parse_mode\": \"MarkdownV2\", \"text\": \"hello\"}"
    }
  },
  {
    "id": "request-numeric-chat-id",
    "kind": "request",
    "why": "A numeric chat id goes on the wire as a JSON number, not a string.",
    "divergence": "fix: disable_web_page_preview replaced by link_preview_options (plan 2.2.7)",
    "env": {
      "NF_CHAT_ID": "-1001234567890",
      "NF_MESSAGE": "hello"
    },
    "expected_v1": {
      "exit": 0,
      "value": "{\"chat_id\": -1001234567890, \"disable_notification\": false, \"disable_web_page_preview\": true, \"parse_mode\": \"MarkdownV2\", \"text\": \"hello\"}"
    },
    "expected_v2": {
      "exit": 0,
      "value": "{\"chat_id\": -1001234567890, \"disable_notification\": false, \"link_preview_options\": {\"is_disabled\": true}, \"parse_mode\": \"MarkdownV2\", \"text\": \"hello\"}"
    }
  },
  {
