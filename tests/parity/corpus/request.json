    "expected_v2": {
      "exit": 0,
      "value": "{\"chat_id\": \"@my_channel\", \"disable_notification\": false, \"link_preview_options\": {\"is_disabled\": true}, \"parse_mode\": \"MarkdownV2\", \"text\": \"hello\"}"
    }
  },
